{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "luax",
      "camelcase": "LuaX",
      "title": "LuaX",
      "scope": "source.luax",
      "file-types": [
        "luax"
      ],
      "injection-regex": "^luax$",
      "class-name": "TreeSitterLuax"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "parser for LuaX",
    "authors": [
      {
        "name": "Duckonaut",
        "email": "duckonaut@gmail.com",
        "url": "duckonaut.dev"
      }
    ],
    "links": {
      "repository": "https://github.com/Duckonaut/tree-sitter-luax",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}